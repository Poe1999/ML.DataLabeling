#3
morph = pymorphy2.MorphAnalyzer()

def lemmatize_text(text):
    text = text.lower()
    text = re.sub(r'[^а-яёa-z\s]', '', text)
    words = text.split()
    lemmas=[]
    for word in words:
        if len(word)<2:
            continue
        try:
            p = morph.parse(word)[0]
            lemma = p.normal_form
            if p.tag.POS in {'NOUN', 'VERB', 'ADJF', 'ADJS'}:
                lemmas.append(lemma)
        except:
            lemmas.append(word)
    return lemmas
df['Лемматизация'] = df['Текст'].apply(lemmatize_text)
print(df['Лемматизация'])


model = SentenceTransformer('cointegrated/rubert-tiny2', device='cpu')

embeddings_original = model.encode(
    df['Текст'].tolist(),
    batch_size=8,
    show_progress_bar=True,
    convert_to_numpy=True
)

print(f"эмбеддинги для исходных текстов{embeddings_original.shape}")

df['Лемматиз_текст'] = df['Лемматизация'].apply(lambda x: ' '.join(x) if isinstance(x, list) else '')
embeddings_lemmatized = model.encode(
