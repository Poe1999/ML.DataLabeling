chrome_options = Options()
chrome_options.add_argument("--headless")
chrome_options.add_argument("--no-sandbox")
chrome_options.add_argument("--disable-dev-shm-usage")
chrome_options.add_argument("--disable-notifications")

prefs = {
    "profile.default_content_setting_values.notifications": 2,
    "profile.default_content_setting_values.geolocation": 2,
    "profile.default_content_setting_values.media_stream_mic": 2,
    "profile.default_content_setting_values.media_stream_camera": 2,
    "profile.default_content_setting_values.popups": 2,
    "profile.managed_default_content_settings.images": 2
}
chrome_options.add_experimental_option("prefs", prefs)
driver = webdriver.Chrome(
    service=Service(ChromeDriverManager().install()),
    options=chrome_options)
url = "https://ria.ru/"
part = 'incidents'
full_url= f'{url}{part}/'
try:
    driver.get(full_url)
    wait = WebDriverWait(driver, 60)
    wait.until(EC.presence_of_element_located((By.CLASS_NAME, "list-item")))
    last_item = driver.find_elements(By.CLASS_NAME, "list-item")[-1]
    driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", last_item)
    more_button = wait.until(
        EC.element_to_be_clickable((By.CSS_SELECTOR, ".list-more.color-btn-second-hover"))
    )
    more_button.click()
    wait.until(
        lambda d: len(d.find_elements(By.CLASS_NAME, "list-item")) >= 30
    )

    soup = BeautifulSoup(driver.page_source, 'html.parser')
    newss = soup.find_all('div', class_='list-item')
    news = []
    while len(news) < 50:
        for block in newss[:50]:
            try:
                title_elem = block.find('a', class_='list-item__title')
                link_elem = block.find('a', class_='list-item__title')

                href = link_elem.get('href')
                if href.startswith('https'):
                    art_url = href
                else:
                    art_url = url + href
                response2 = requests.get(art_url)
                soup2 = BeautifulSoup(response2.text, 'html.parser')
                text_elem = soup2.find('div', class_='article__text')

                news.append({
                    'Заголовок': title_elem.text.strip() if title_elem else "Нет заголовка",
                    'Текст': text_elem.get_text() if text_elem else "Нет текста"
                })
            except:
                pass
finally:
    driver.quit()


