import cv2
import albumentations as A
import os
import glob
from tqdm import tqdm
import platform

print(f"[DEBUG] Система: {platform.system()}, Python: {platform.python_version()}")

BASE_DIR = r"C:\Users\polub\gASS project\ML.Data labeling\Lab7"


ORIGINAL_DIR = os.path.join(BASE_DIR, "orig_dataset", "train")
if not os.path.exists(ORIGINAL_DIR):
    raise FileNotFoundError(f"Папка не существует: {ORIGINAL_DIR}")

AUG_DIR = os.path.join(BASE_DIR, "aug_dataset", "train")
IMAGES_DIR = os.path.join(AUG_DIR, "images")
LABELS_DIR = os.path.join(AUG_DIR, "labels")

os.makedirs(IMAGES_DIR, exist_ok=True)
os.makedirs(LABELS_DIR, exist_ok=True)
print(f"[DEBUG] Папки созданы:\n- {IMAGES_DIR}\n- {LABELS_DIR}")

image_files = glob.glob(os.path.join(ORIGINAL_DIR, "images", "*.jpg"))
print(f"[DEBUG] Найдено исходных изображений: {len(image_files)}")
if len(image_files) == 0:
    raise ValueError("Нет JPG-файлов в папке train/images!")

transform = A.Compose([
    A.HorizontalFlip(p=0.5),
    A.Rotate(limit=5, p=0.3, border_mode=cv2.BORDER_CONSTANT, value=0),
    A.Affine(
        translate_percent={"x": (-0.05, 0.05), "y": (-0.05, 0.05)},
        scale=(0.95, 1.05),
        p=0.2
    ),
    A.RandomBrightnessContrast(p=0.3),
], bbox_params=A.BboxParams(
    format='yolo',
    min_visibility=0.3,
    label_fields=['class_labels'],
    clip=True
))

processed_count = 0
error_count = 0

for img_path in tqdm(image_files, desc="Аугментация"):
    try:
        img = cv2.imread(img_path)
        if img is None:
            print(f"[ERROR] Не удалось прочитать изображение: {img_path}")
            error_count += 1
            continue

        label_path = os.path.join(
            ORIGINAL_DIR,
            "labels",
            os.path.basename(img_path).replace(".jpg", ".txt")
        )

        bboxes = []
        class_labels = []

        if os.path.exists(label_path) and os.path.getsize(label_path) > 0:
            with open(label_path, 'r') as f:
                for line in f:
                    parts = line.strip().split()
                    if len(parts) < 5:
                        continue
                    try:
                        class_id = int(float(parts[0]))
                        bbox = list(map(float, parts[1:5]))
                        if all(0 <= x <= 1 for x in bbox):
                            bboxes.append(bbox)
                            class_labels.append(class_id)
                    except (ValueError, TypeError) as e:
                        print(f"[WARN] Некорректная аннотация в {label_path}: {line.strip()}")
                        continue

        if not bboxes:
            print(f"[SKIP] Нет валидных аннотаций для: {os.path.basename(img_path)}")
            continue

        augmented = transform(
            image=img,
            bboxes=bboxes,
            class_labels=class_labels
        )


        new_img_name = f"aug_{os.path.basename(img_path)}"
        new_img_path = os.path.join(IMAGES_DIR, new_img_name)
        new_label_path = os.path.join(LABELS_DIR, new_img_name.replace(".jpg", ".txt"))

        success = cv2.imwrite(new_img_path, augmented['image'])
        if not success:
            print(f"[ERROR] Не удалось сохранить изображение: {new_img_path}")
            error_count += 1
            continue


        with open(new_label_path, 'w') as f:
            for class_id, bbox in zip(augmented['class_labels'], augmented['bboxes']):
                f.write(f"{class_id} {bbox[0]:.6f} {bbox[1]:.6f} {bbox[2]:.6f} {bbox[3]:.6f}\n")

        processed_count += 1

    except Exception as e:
        print(f"[CRITICAL] Ошибка при обработке {img_path}:\n{str(e)}")
        error_count += 1
        continue


print(f"Успешно обработано: {processed_count} изображений")
print(f" Ошибок: {error_count}")
print(f"Аугментированные данные сохранены в:\n- {IMAGES_DIR}\n- {LABELS_DIR}")


if processed_count > 0:
    print("\n[VERIFICATION] Пример сохраненных файлов:")
    for i, file in enumerate(os.listdir(IMAGES_DIR)[:3]):
        print(f"  {i + 1}. {file}")
else:
    print("\nНЕ СОЗДАНО НИ ОДНОГО ФАЙЛА!")

